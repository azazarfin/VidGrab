{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidGrab",
  "version": "0.1.0",
  "identifier": "com.vidgrab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "VidGrab", "width": 620, "height": 640, "minWidth": 390, "minHeight": 480}],
    "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "publisher": "VidGrab contributors",
    "shortDescription": "VidGrab P02 desktop companion fixture spike",
    "externalBin": ["binaries/vidgrab-native-host"],
    "resources": {"resources/engine/": "engine/"},
    "linux": {"deb": {"depends": ["libc6 (>= 2.42)", "libwebkit2gtk-4.1-0", "libgtk-3-0t64 | libgtk-3-0", "libayatana-appindicator3-1"]}}
  }
}
